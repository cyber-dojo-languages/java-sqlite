<?xml version="1.0" encoding="UTF-8"?>
<!-- Declares only the libraries a kata names directly. Everything else they
     drag in is resolved from here rather than listed, so the set of jars in the
     image is consistent by construction instead of by somebody keeping a list
     in step by hand.

     The versions below are a starting point, not the versions installed.
     install_jars.sh moves each to its newest release before resolving. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <groupId>org.cyber-dojo</groupId>
  <artifactId>java-sqlite-jars</artifactId>
  <version>1</version>
  <packaging>pom</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.47.0.0</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
    </dependency>
    <!-- Named rather than left to JUnit to supply. JUnit 4 brings only
         hamcrest-core, and a kata reaching for a matcher beyond the core ones
         would not find it. -->
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <version>3.0</version>
    </dependency>
    <!-- sqlite-jdbc logs through slf4j. Without a binding it prints a warning
         about the missing one on every run, which a learner would read as
         something they had done. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.16</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.16</version>
    </dependency>
  </dependencies>

</project>
